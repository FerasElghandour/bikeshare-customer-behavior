    "methodology": [
      {
        "title": "Calendar-aware comparison",
        "body": "Daily volumes use the full observed calendar interval, including any zero-trip dates. Duration comparisons retain all valid trips."
      },
      {
        "title": "Uncertainty with a defined estimand",
        "body": "2,000 fixed-seed resamples of paired dates estimate the mean difference between daily category medians. This is not the pooled trip median difference."
      },
      {
        "title": "Decision boundary",
        "body": "Use the results to investigate station capacity and duration patterns. One month of observational trips does not prove user intent, a causal membership effect or unique-customer behavior."
      }
    ],
    "notes": "Only aggregate summaries are embedded. Input trips and demographic fields are not published."
  },
